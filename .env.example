# Copy to .env for local use. These are safe local-only values.

# --- PostgreSQL container ---
POSTGRES_USER=checkout
POSTGRES_PASSWORD=checkout_local_pw
POSTGRES_DB=checkout
DB_PORT=5432
API_PORT=8000

# --- Application (host runs) ---
# Inside docker compose the API uses host "db" automatically.
DATABASE_URL=postgresql+psycopg://checkout:checkout_local_pw@localhost:5432/checkout
# Test suite database (created automatically on the same server)
TEST_DATABASE_URL=postgresql+psycopg://checkout:checkout_local_pw@localhost:5432/checkout_test

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Reward rule: every Nth successful order makes one X% coupon available.
REWARD_EVERY_N_ORDERS=5
REWARD_DISCOUNT_PERCENT=10

MAX_LINE_QUANTITY=100
MAX_CART_ITEMS=50
LOG_LEVEL=INFO
